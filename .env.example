# Local development settings. Copy to `.env` (never commit `.env`).
# `docker compose up` does not need this file: compose sets its own development values.

DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789abcdef
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres and Redis from `docker compose up -d db redis` (published on 5433 / 6380 to avoid
# clashing with locally installed services).
DATABASE_URL=postgres://eve:eve@localhost:5433/eve
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

JWT_SIGNING_KEY=dev-only-insecure-jwt-signing-key-0123456789abcdef0123

# Webhook secrets accepted from the payment provider (comma-separated to allow rotation).
# MockPay signs with the first one unless MOCKPAY_WEBHOOK_SECRET is set.
WEBHOOK_SECRETS=whsec_ZGV2LW9ubHktbW9ja3BheS13ZWJob29rLXNlY3JldCE=

# Logging: pretty console output locally, JSON lines in containers.
LOG_JSON=false
LOG_LEVEL=INFO
